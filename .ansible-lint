---
# Configuration for ansible-lint
profile: production

# Ignored paths during linting
exclude_paths:
  - .github/
  - inventories/

# Rules to skip (in case of false-positives)
  - yaml[comments]    # Do not trigger errors for missing comments in YAML
  - fqcn[action-core] # If ansible.builtin. prefix is omitted
  - var-naming        # Allow global variable names in defaults/
