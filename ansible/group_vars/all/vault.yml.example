---
# Copy this file to vault.yml, fill in real values, then encrypt it:
#   cp vault.yml.example vault.yml
#   ansible-vault encrypt vault.yml
#
# This file lists every secret referenced across roles via {{ vault_* }} —
# nothing here is a real credential.

vault_cloudflare_tunnel_token: "changeme"

vault_foundry_username: "changeme"
vault_foundry_password: "changeme"
vault_foundry_admin_key: "changeme"

vault_nextcloud_password: "changeme"
vault_nextcloud_db_password: "changeme"
vault_nextcloud_domain: "changeme"

vault_wireguard_private_key: "changeme"
vault_wireguard_addresses: "changeme"
vault_server_countries: "changeme"

vault_kopia_password: "changeme"
